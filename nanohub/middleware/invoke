#!/bin/sh
# nanoHUB middleware invoke script for SOLIDIFY Interactive Solidification Lab.
# Kept in sync with root /middleware/invoke (which nanoHUB executes).

/usr/bin/invoke_app "$@" -t solidify \
  -C "start_jupyter -t -c -T @tool nanohub/notebooks/Solidify_Interactive_Lab.ipynb" \
  -u anaconda-7 \
  -r none \
  -w headless
