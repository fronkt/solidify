# The hero's frame contract is digested byte for byte: hero/timeline.json's
# sha1 (over the LF file) is recorded by path_plan.py, render_sequence.py, the
# encoder and the manifest, and the manifest's own text is part of the frame
# directory's content hash. A core.autocrlf checkout would turn them CRLF and
# the digests with them, so they are LF on every checkout.
hero/*.json text eol=lf
public/hero/manifest.json text eol=lf

# These scientific exports retain the exact bytes recorded by their provenance
# JSON. Do not normalize CSV, caption, SVG or provenance line endings in Git.
docs/validation/quant3d-angular-kinetic-fit-sensitivity-2026-10-31.* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
docs/validation/quant3d-capillary-grid-c100-2026-10-31.* -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
# Preserve Matplotlib's original path formatting for the recorded hashes.
docs/validation/quant3d-angular-kinetic-fit-sensitivity-2026-10-31.svg -whitespace
docs/validation/quant3d-capillary-grid-c100-2026-10-31.svg -whitespace
# Q3c replay summary: its SHA256 is quoted in the Q3c report; keep exact bytes.
docs/validation/quant3d-q3c-replay-2026-11-07.json -text
